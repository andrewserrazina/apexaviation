# Apex Advantage mobile client -- environment configuration.
#
# Copy this file to .env and fill in real values before running the app.
# Both variables below are PUBLIC/CLIENT-SAFE by design (Expo inlines any
# EXPO_PUBLIC_* variable into the JS bundle -- never put a secret in one).
#
# NEVER put any of the following in this file, in .env, or anywhere in
# this app's source: the Supabase service-role key, the database
# password/connection string, a Stripe secret key, the lifecycle cron
# secret, or any admin/service token. This app only ever talks to
# Supabase through the publishable/anon key below plus a signed-in
# learner's own session -- every Edge Function it calls re-verifies that
# session and the caller's entitlement server-side.

# Supabase project URL (wqzfhcjsfzwrimvsudxy in production).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable ("anon") key -- safe to ship in a client bundle.
# Get this from Supabase Dashboard > Project Settings > API, or via
# `mcp__Supabase__get_publishable_keys` if you have MCP access to the
# project. This is NOT the service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
